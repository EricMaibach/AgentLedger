{
  "ConnectionStrings": {
    // Supplied by the environment: the dev container sets ConnectionStrings__AgentLedger,
    // and functional tests point it at a Testcontainers Postgres instance.
    "AgentLedger": ""
  },
  "Database": {
    // Migrations always run in Development; set true to also run them on startup elsewhere.
    "ApplyMigrationsOnStartup": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
