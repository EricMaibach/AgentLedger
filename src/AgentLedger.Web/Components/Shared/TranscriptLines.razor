@* A transcript file's lines (docs/ui.md, TranscriptLines): offset, the line's own `type` field, a one-line
   preview; expanding a line shows all of it, Formatted or Exact, with a copy button. No script needed. *@
<ol class="transcript-lines">
  @foreach (var line in Lines)
  {
    var type = TranscriptLineDisplay.TypeOf(line.Text);
    <li>
      <details>
        <summary>
          <span class="offset" title="Byte offset in the file">@line.ByteOffset</span>
          @if (type is not null)
          {
            <span class="badge @(type == TranscriptLineDisplay.NotJson ? "not-json" : "")">@type</span>
          }
          <code class="preview">@TranscriptLineDisplay.Preview(line.Text)</code>
        </summary>
        <div class="line">
          <CopyButton Text="@line.Text" Label="@($"Copy line at offset {line.ByteOffset} (exact text)")" />
          <pre><code>@(Exact ? line.Text : JsonDisplay.Indent(line.Text))</code></pre>
        </div>
      </details>
    </li>
  }
</ol>

@code {
  [Parameter, EditorRequired] public IReadOnlyList<UseCases.Transcripts.TranscriptLineItem> Lines { get; set; } = [];

  /// <summary>Show each line exactly as stored, instead of indented.</summary>
  [Parameter] public bool Exact { get; set; }
}
