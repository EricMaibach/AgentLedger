@* Every tabular list (docs/ui.md): a semantic table with a caption for assistive technology, a sticky
   header, and horizontal scrolling on narrow screens. *@
<div class="table-wrap">
  <table class="data-table">
    <caption class="visually-hidden">@Caption</caption>
    <thead><tr>@Header</tr></thead>
    <tbody>@ChildContent</tbody>
  </table>
</div>

@code {
  [Parameter, EditorRequired] public string Caption { get; set; } = string.Empty;
  [Parameter, EditorRequired] public RenderFragment Header { get; set; } = default!;
  [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
}
