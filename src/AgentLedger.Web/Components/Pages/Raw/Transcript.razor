@page "/raw/sessions/{Session}/transcript"
@inject IMediator Mediator

@* One session's transcript, raw, in file order (ADR 0020; docs/ui.md, Transcript page). No conversation
   rendering: that's interpretation, for projections. *@

<PageTitle>Transcript · @DisplayFormat.ShortId(Session) · AgentLedger</PageTitle>

<p class="breadcrumb"><a href="@RawEventsLink.Path">Raw events</a> / <a href="@SessionEventsHref">session <code>@DisplayFormat.ShortId(Session)</code></a> / transcript</p>
<h1>Transcript</h1>

@if (Errors.Count > 0)
{
  <div class="alert" role="alert">
    @foreach (var error in Errors)
    {
      <p>@error</p>
    }
  </div>
}
else if (Files.Count == 0)
{
  <EmptyState Message="No transcript for this session.">
    <a href="@SessionEventsHref">See the session's events</a>
  </EmptyState>
}
else
{
  <nav class="files" aria-label="Transcript files">
    <ul>
      @foreach (var file in Files)
      {
        var current = file.File == CurrentFile;
        <li>
          <a href="@TranscriptLink.To(Session, file.File, ShowExact)" aria-current="@(current ? "page" : null)">
            @(file.SubagentId is { } subagent ? $"Subagent {subagent}" : "Main")
          </a>
          <span class="count">@file.LineCount lines</span>
        </li>
      }
    </ul>
  </nav>

  @if (CurrentFileItem?.Meta is { } meta)
  {
    <JsonViewer Json="@meta" Title="Subagent meta" Exact="@ShowExact"
                FormattedHref="@TranscriptLink.To(Session, CurrentFile)" ExactHref="@TranscriptLink.To(Session, CurrentFile, exact: true)" />
  }

  <section aria-labelledby="lines-heading">
    <div class="lines-toolbar">
      <h2 id="lines-heading">Lines</h2>
      <nav aria-label="Line view">
        <a href="@TranscriptLink.To(Session, CurrentFile, exact: false, after: After)" aria-current="@(ShowExact ? null : "true")">Formatted</a>
        <a href="@TranscriptLink.To(Session, CurrentFile, exact: true, after: After)" aria-current="@(ShowExact ? "true" : null)">Exact</a>
      </nav>
    </div>

    @if (Page is { Items.Count: > 0 })
    {
      <TranscriptLines Lines="Page.Items" Exact="ShowExact" />
      <Pager FirstLabel="Start" NextLabel="Next lines"
             NewerHref="@(After is { Length: > 0 } ? TranscriptLink.To(Session, CurrentFile, ShowExact) : null)"
             OlderHref="@(Page.Next is { } next ? WithLimit(TranscriptLink.To(Session, CurrentFile, ShowExact, TranscriptCursorCodec.Encode(next))) : null)" />
    }
    else
    {
      <EmptyState Message="No lines in this file." />
    }
  </section>
}

@code {
  [Parameter] public string Session { get; set; } = string.Empty;
  [SupplyParameterFromQuery] public string? File { get; set; }
  [SupplyParameterFromQuery] public string? View { get; set; }
  [SupplyParameterFromQuery] public string? After { get; set; }
  [SupplyParameterFromQuery] public string? Limit { get; set; }

  private IReadOnlyList<UseCases.Transcripts.TranscriptFileItem> Files { get; set; } = [];
  private UseCases.Transcripts.TranscriptLinePage? Page { get; set; }
  private List<string> Errors { get; } = [];

  private string CurrentFile => string.IsNullOrWhiteSpace(File) ? TranscriptLink.MainFile : File;
  private UseCases.Transcripts.TranscriptFileItem? CurrentFileItem => Files.FirstOrDefault(f => f.File == CurrentFile);
  private bool ShowExact => string.Equals(View, "exact", StringComparison.OrdinalIgnoreCase);
  private string SessionEventsHref => RawEventsLink.To(new RawEventsQueryString(Session: Session));

  // A non-default page size carries through to the next page.
  private string WithLimit(string href) => int.TryParse(Limit, out var limit) && limit != UseCases.Constants.DEFAULT_PAGE_SIZE
    ? $"{href}{(href.Contains('?') ? '&' : '?')}limit={limit}"
    : href;

  protected override async Task OnInitializedAsync()
  {
    var files = await Mediator.Send(new UseCases.Transcripts.ListTranscriptFiles.ListTranscriptFilesQuery(Session));
    if (!files.IsSuccess)
    {
      Errors.AddRange(files.ValidationErrors.Select(e => e.ErrorMessage));
      return;
    }

    Files = files.Value;
    if (Files.Count == 0)
    {
      return;
    }

    UseCases.Transcripts.TranscriptLineCursor? after = null;
    if (After is { Length: > 0 } && !TranscriptCursorCodec.TryDecode(After, out after))
    {
      Errors.Add("This page link isn't valid any more. Start again from the beginning of the file.");
      return;
    }

    var limit = int.TryParse(Limit, out var parsed) ? parsed : UseCases.Constants.DEFAULT_PAGE_SIZE;
    var lines = await Mediator.Send(new UseCases.Transcripts.ListTranscriptLines.ListTranscriptLinesQuery(Session, CurrentFile, after, limit));
    if (!lines.IsSuccess)
    {
      Errors.AddRange(lines.ValidationErrors.Select(e => e.ErrorMessage));
      return;
    }

    Page = lines.Value;
  }
}
