@page "/work"
@* Interactive (ADR 0023): choosing sessions, turns and steps updates only what changed, keeps each pane's scroll
   position, and later carries live updates. Every selection is also a real link, so the page works as plain page loads
   too. *@
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider Authentication

@if (!_leaving && State is not null)
{
  <PageTitle>@(State.Session?.Session.Title ?? "Work") · AgentLedger</PageTitle>

  <div class="work-layout @(State.Step is null ? "no-details" : null)" @ref="_layout">
    <section class="pane units" aria-label="Sessions">
      <div class="pane-header">
        <span>Lens: <strong>Session</strong></span>
        <button type="button" class="collapse" data-collapse="left" aria-label="Collapse sessions" title="Collapse">‹</button>
      </div>
      <SessionList Sessions="State.Sessions" SelectedId="State.SessionId" HasMore="State.MoreSessions is not null"
                   OnShowOlder="ShowOlderAsync" />
    </section>
    <div class="divider" data-divider="left" role="separator" aria-orientation="vertical" aria-label="Resize sessions" tabindex="0"></div>
    <section class="pane turns" aria-label="Turns" data-turns-pane>
      @if (State.Session is { } session && State.Turns is { } turns)
      {
        <SessionSummary Detail="session" />
        <TurnList SessionId="session.Session.SessionId" Turns="turns" ExpandedTurnId="State.ExpandedTurnId" Steps="State.Steps"
                  SelectedStepId="State.Step?.StepId" />
      }
      else
      {
        <EmptyState Message="Choose a session to see its turns." />
      }
    </section>
    @if (State.Step is { } step && State.SessionId is { } sessionId)
    {
      <div class="divider" data-divider="right" role="separator" aria-orientation="vertical" aria-label="Resize details" tabindex="0"></div>
      <section class="pane details" aria-label="Step details">
        <div class="pane-header">
          <button type="button" class="collapse" data-collapse="right" aria-label="Collapse details" title="Collapse">›</button>
        </div>
        <StepDetails Step="step" CloseHref="@WorkLink.To(sessionId, State.ExpandedTurnId)" />
      </section>
    }
  </div>
}

@code {
  [SupplyParameterFromQuery(Name = "unit")] public Guid? Unit { get; set; }
  [SupplyParameterFromQuery(Name = "turn")] public Guid? Turn { get; set; }
  [SupplyParameterFromQuery(Name = "step")] public Guid? StepParameter { get; set; }

  // Loaded while prerendering, then handed to the interactive page (ADR 0023).
  [PersistentState] public WorkState? State { get; set; }

  private ElementReference _layout;
  private IJSObjectReference? _module;
  private DotNetObjectReference<WorkPage>? _self;
  private bool _leaving;
  private bool _scroll = true;

  protected override async Task OnInitializedAsync()
  {
    Authentication.AuthenticationStateChanged += OnAuthenticationChanged;
    if (State is not null)
      return;

    var sessions = await Mediator.Send(new UseCases.Work.ListSessions.ListSessionsQuery(null, Constants.DEFAULT_PAGE_SIZE));
    State = new WorkState(sessions.Value.Items, sessions.Value.Next, null, null, null, null, null);
    if (!await SelectAsync(Unit, Turn, StepParameter))
    {
      _leaving = true;
      Navigation.NotFound(); // an unknown session in the URL
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_leaving)
      return;
    if (firstRender)
    {
      _self = DotNetObjectReference.Create(this);
      _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Work/WorkPage.razor.js");
      await _module.InvokeVoidAsync("init", _layout, _self);
    }
    if (_scroll && _module is not null)
    {
      _scroll = false;
      await _module.InvokeVoidAsync("scrollToTurn", _layout);
    }
  }

  /// <summary>Called by the page's script for a plain click on a work link, and for Back and Forward.</summary>
  [JSInvokable]
  public async Task GoAsync(string url)
  {
    var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(url).Query);
    await SelectAsync(GuidOf(query, "unit"), GuidOf(query, "turn"), GuidOf(query, "step"));
    StateHasChanged();
  }

  // Loads what the selection needs, reusing what's already loaded. False when the session doesn't exist.
  private async Task<bool> SelectAsync(Guid? unit, Guid? turn, Guid? step)
  {
    var state = State!;
    if (unit != state.SessionId)
    {
      state = state with { Session = null, Turns = null, ExpandedTurnId = null, Steps = null, Step = null };
      if (unit is { } sessionId)
      {
        var session = await Mediator.Send(new UseCases.Work.GetSession.GetSessionQuery(sessionId));
        var turns = await Mediator.Send(new UseCases.Work.ListTurns.ListTurnsQuery(sessionId));
        if (!session.IsSuccess || !turns.IsSuccess)
          return false;
        state = state with { Session = session.Value, Turns = turns.Value };
      }
      _scroll = true;
    }

    if (step is not null && turn is null && unit is not null)
      turn = (await Mediator.Send(new UseCases.Work.LocateWork.LocateStepQuery(step.Value))).Value?.TurnId;

    if (turn != state.ExpandedTurnId)
    {
      state = state with { ExpandedTurnId = null, Steps = null, Step = null };
      if (turn is { } turnId && state.Session is not null)
      {
        var steps = await Mediator.Send(new UseCases.Work.ListSteps.ListStepsQuery(turnId));
        if (steps.IsSuccess)
          state = state with { ExpandedTurnId = turnId, Steps = steps.Value };
      }
    }

    if (step != state.Step?.StepId)
    {
      state = state with { Step = null };
      if (step is { } stepId && state.ExpandedTurnId is not null)
      {
        var detail = await Mediator.Send(new UseCases.Work.GetStep.GetStepQuery(stepId));
        if (detail.IsSuccess && detail.Value.Location.TurnId == state.ExpandedTurnId)
          state = state with { Step = detail.Value };
      }
    }

    State = state;
    return true;
  }

  private async Task ShowOlderAsync()
  {
    if (State?.MoreSessions is not { } after)
      return;
    var page = await Mediator.Send(new UseCases.Work.ListSessions.ListSessionsQuery(after, Constants.DEFAULT_PAGE_SIZE));
    State = State with { Sessions = [.. State.Sessions, .. page.Value.Items], MoreSessions = page.Value.Next };
  }

  // The security stamp no longer matches (password changed or reset elsewhere, ADR 0018): back to the login page.
  private async void OnAuthenticationChanged(Task<AuthenticationState> changed)
  {
    var state = await changed;
    if (state.User.Identity?.IsAuthenticated != true)
      await InvokeAsync(() => Navigation.NavigateTo("/login", forceLoad: true));
  }

  private static Guid? GuidOf(Dictionary<string, Microsoft.Extensions.Primitives.StringValues> query, string name) =>
    query.TryGetValue(name, out var value) && Guid.TryParse(value, out var id) ? id : null;

  public async ValueTask DisposeAsync()
  {
    Authentication.AuthenticationStateChanged -= OnAuthenticationChanged;
    if (_module is not null)
    {
      try
      {
        await _module.InvokeVoidAsync("dispose", _layout);
        await _module.DisposeAsync();
      }
      catch (JSDisconnectedException)
      {
        // The browser has gone; nothing to clean up there.
      }
    }
    _self?.Dispose();
  }
}
