@page "/account/password"
@inject IMediator Mediator

@* Change your own password (ADR 0018). Your other sessions end; this one continues. *@

<PageTitle>Change password · AgentLedger</PageTitle>

<FormPanel Title="Change password" Errors="Errors" Success="@Success"
           Intro="Your other sessions are signed out when you change it.">
  <EditForm Model="Input" FormName="change-password" OnSubmit="ChangeAsync">
    <label>
      Current password
      <InputText type="password" @bind-Value="Input.CurrentPassword" autocomplete="current-password" required />
    </label>
    <label>
      New password (at least @Core.UserAggregate.PasswordRules.MinLength characters)
      <InputText type="password" @bind-Value="Input.NewPassword" autocomplete="new-password" required />
    </label>
    <label>
      New password again
      <InputText type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" required />
    </label>
    <button type="submit">Change password</button>
  </EditForm>
</FormPanel>

@code {
  [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;
  // Bound from a posted form, and null otherwise (so no initializer, BL0008); OnInitialized fills it in.
  [SupplyParameterFromForm] private ChangePasswordInput Input { get; set; } = default!;

  private List<string> Errors { get; } = [];
  private string? Success { get; set; }

  protected override void OnInitialized() => Input ??= new ChangePasswordInput();

  private async Task ChangeAsync()
  {
    if (Input.NewPassword != Input.ConfirmPassword)
    {
      Errors.Add("The new passwords don't match.");
      return;
    }

    if (!SessionCookie.TryRead(HttpContext.User, out var userId, out _))
    {
      Errors.Add("Sign in again to change your password.");
      return;
    }

    var result = await Mediator.Send(new UseCases.Users.ChangePassword.ChangePasswordCommand(
      userId, Input.CurrentPassword ?? "", Input.NewPassword ?? ""));
    if (!result.IsSuccess)
    {
      Errors.AddRange(result.ValidationErrors.Select(e => e.ErrorMessage).Concat(result.Errors));
      return;
    }

    // Re-issue this session's cookie with the new security stamp; other sessions still carry the old one.
    await SessionCookie.SignInAsync(HttpContext, result.Value);
    Success = "Password changed.";
    Input = new ChangePasswordInput(); // don't send the passwords back in the page
  }

  private sealed class ChangePasswordInput
  {
    public string? CurrentPassword { get; set; }
    public string? NewPassword { get; set; }
    public string? ConfirmPassword { get; set; }
  }
}
