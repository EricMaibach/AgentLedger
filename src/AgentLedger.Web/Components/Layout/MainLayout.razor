@inherits LayoutComponentBase

@* The navigation shell (docs/ui.md, "Structure"). Work (projections, ADR 0023) comes first, then the raw sections.
   Sections and the account menu show only when signed in. *@
<a class="skip-link" href="#main">Skip to content</a>
<header class="app-header">
  <a class="brand" href="@WorkLink.Path">AgentLedger</a>
  <span class="version" title="Running build">@BuildInfo.Version</span>
  @if (Username is not null)
  {
    <div class="account">
      <span class="username" title="Signed in">@Username</span>
      <a href="/account/password">Change password</a>
      <form method="post" action="/logout">
        <AntiforgeryToken />
        <button type="submit">Sign out</button>
      </form>
    </div>
  }
</header>
@if (Username is not null)
{
  <nav class="app-nav" aria-label="Sections">
    <NavLink href="@WorkLink.Path" Match="NavLinkMatch.Prefix">Work</NavLink>
    <NavLink href="@RawEventsLink.Path" Match="NavLinkMatch.Prefix">Raw events</NavLink>
    <NavLink href="@RawTranscriptsLink.Path" Match="NavLinkMatch.Prefix">Raw transcripts</NavLink>
    <NavLink href="/settings/api-keys" Match="NavLinkMatch.Prefix">Settings</NavLink>
  </nav>
}
<main id="main" class="app-main">
  @Body
</main>

@code {
  [CascadingParameter] public HttpContext? HttpContext { get; set; }

  private string? Username => HttpContext?.User.Identity is { IsAuthenticated: true } identity ? identity.Name : null;
}
