{
  "name": "AgentLedger Dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "remoteUser": "vscode",
  // Dogfooding: build the agentledger CLI and install its Claude Code hooks (docs/adr/0014)
  "postCreateCommand": ".devcontainer/install-agentledger.sh",
  // The ingest key for the stable ledger (docs/adr/0019), from the machine running VS Code, so it survives
  // rebuilds and is never committed. Empty when unset; the CLI then has no key and events wait in its spool.
  "remoteEnv": {
    "AGENTLEDGER_API_KEY": "${localEnv:AGENTLEDGER_API_KEY}"
  },
  // The stable ledger publishes 58090 on the Docker host. If VS Code auto-forwarded that port from this
  // container, the forward could hold it and stop the ledger stack from starting.
  "portsAttributes": {
    "58090": { "onAutoForward": "ignore" }
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Lets tests (Testcontainers) start throwaway containers via the host's Docker
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "anthropic.claude-code",
        "ms-ossdata.vscode-pgsql",
        // VS Code doesn't read .editorconfig on its own; without this, typing indents C# with 4 spaces instead of 2
        "EditorConfig.EditorConfig"
      ],
      "settings": {
        // Applies .editorconfig (via the C# extension) on every save, so dotnet format --verify-no-changes stays green
        "[csharp]": { "editor.formatOnSave": true }
      }
    }
  }
}
