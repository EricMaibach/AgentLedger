{
  "name": "AgentLedger Dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "remoteUser": "vscode",
  // Dogfooding: build the agentledger CLI and install its Claude Code hooks (docs/adr/0014)
  "postCreateCommand": ".devcontainer/install-agentledger.sh",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Lets tests (Testcontainers) start throwaway containers via the host's Docker
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "anthropic.claude-code",
        "ms-ossdata.vscode-pgsql"
      ]
    }
  }
}
