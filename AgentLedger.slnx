<Solution>
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="x64" />
    <Platform Name="x86" />
  </Configurations>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/AgentLedger.Cli/AgentLedger.Cli.csproj" />
    <Project Path="src/AgentLedger.Core/AgentLedger.Core.csproj" />
    <Project Path="src/AgentLedger.Infrastructure/AgentLedger.Infrastructure.csproj" />
    <Project Path="src/AgentLedger.UseCases/AgentLedger.UseCases.csproj" />
    <Project Path="src/AgentLedger.ServiceDefaults/AgentLedger.ServiceDefaults.csproj" />
    <Project Path="src/AgentLedger.Web/AgentLedger.Web.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/AgentLedger.Cli.Tests/AgentLedger.Cli.Tests.csproj" />
    <Project Path="tests/AgentLedger.FunctionalTests/AgentLedger.FunctionalTests.csproj">
      <BuildDependency Project="src/AgentLedger.Web/AgentLedger.Web.csproj" />
    </Project>
    <Project Path="tests/AgentLedger.IntegrationTests/AgentLedger.IntegrationTests.csproj">
      <BuildDependency Project="src/AgentLedger.Infrastructure/AgentLedger.Infrastructure.csproj" />
    </Project>
    <Project Path="tests/AgentLedger.UnitTests/AgentLedger.UnitTests.csproj" />
  </Folder>
</Solution>
